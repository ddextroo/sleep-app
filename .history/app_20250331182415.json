{
  "expo": {
    "scheme": "hagoc",
    "owner": "dextro",
    "platforms": ["ios", "android", "web"],
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": ["**/*"],
    "fonts": [
      "./src/assets/fonts/Poppins-Regular.ttf",
      "./src/assets/fonts/Poppins-Bold.ttf",
      "./src/assets/fonts/Poppins-Medium.ttf"
    ],
    "icon": "./src/assets/images/icon_hagoc.png",
    "splash": {
      "image": "./src/assets/images/logo_hagoc.png",
      "resizeMode": "contain",
      "backgroundColor": "#050404"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-asset",
        {
          "assets": [
            "./src/assets/images/onb1.png",
            "./src/assets/images/onb2.png",
            "./src/assets/images/onb3.png",
            "./src/assets/listen_stories/djraqi1.mp"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050404",
          "image": "./src/assets/images/logo_hagoc.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "name": "Hagoc",
    "slug": "Hagoc",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "426350b3-6ecd-4abf-97c3-10eb2366805c"
      }
    },
    "android": {
      "package": "com.phpastil.hagoc",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "hagoc",
              "host": "redirect"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
